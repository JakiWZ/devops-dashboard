NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Origini consentite per CORS, separate da virgola
CORS_ORIGIN=http://localhost:5173
# Placeholder: sostituisci con le tue credenziali locali
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/devops_dashboard?schema=public
# Database separato per i test di integrazione: viene svuotato a ogni test
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/devops_dashboard_test?schema=public

# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
BCRYPT_ROUNDS=12
# Tentativi per IP ogni 15 minuti su login/register/forgot/reset
AUTH_RATE_LIMIT=20
APP_URL=http://localhost:5173

# TODO: crea un account Resend e inserisci la chiave. Senza chiave le email non vengono inviate
# (in development il link di reset viene solo scritto nei log).
RESEND_API_KEY=
EMAIL_FROM=DevOps Dashboard <onboarding@resend.dev>

# Chiave per cifrare i segreti degli utenti: token GitHub e chiavi AI (32 byte in base64).
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Senza chiave le funzioni GitHub e il salvataggio delle chiavi AI rispondono 503.
# (Il vecchio nome GITHUB_TOKEN_ENC_KEY è ancora accettato.)
SECRETS_ENC_KEY=
# Sync automatico dei repository (minuti, 0 = disattivato)
SYNC_INTERVAL_MINUTES=360
# Sync manuali per IP ogni 15 minuti
SYNC_RATE_LIMIT=10

# Provider AI di default del server, per chi non ha inserito una propria chiave nella dashboard.
# AI_PROVIDER è un id del catalogo https://models.dev (es. anthropic, openai, google, deepseek,
# zai-coding-plan); AI_MODEL un id di modello di quel provider (default claude-opus-5-5 per anthropic).
# TODO: crea una chiave presso il provider scelto e inseriscila qui. Senza chiave del server né
# dell'utente, POST /api/reports risponde 503 AI_NOT_CONFIGURED.
AI_PROVIDER=anthropic
AI_MODEL=
AI_API_KEY=
# Verifiche di chiavi AI per IP ogni 15 minuti
AI_KEY_CHECK_RATE_LIMIT=20
# Solo per Anthropic: low | medium | high | xhigh | max, e fallback server-side sui rifiuti
REPORT_EFFORT=high
REPORT_FALLBACKS=true
REPORT_LANGUAGE=English
REPORT_RATE_LIMIT=10
