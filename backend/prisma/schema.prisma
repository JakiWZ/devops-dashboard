generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum SyncStatus {
  IDLE
  SYNCING
  FAILED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  role                Role                 @default(USER)
  createdAt           DateTime             @default(now())
  // Personal access token GitHub cifrato con AES-256-GCM (mai in chiaro nel DB).
  githubTokenEnc      String?
  githubLogin         String?
  repositories        Repository[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  aiCredential        AiCredential?
  notificationPrefs   NotificationPreference?
  notificationEvents  NotificationEvent[]
}

// Cosa ricevere, dove e quando. Senza riga valgono i default (tutto spento).
model NotificationPreference {
  id                 String    @id @default(cuid())
  userId             String    @unique
  emailEnabled       Boolean   @default(false)
  telegramEnabled    Boolean   @default(false)
  // Chat Telegram collegata tramite il comando /start del bot (null se non collegata).
  telegramChatId     String?
  // Codice monouso per collegare Telegram: in DB solo l'hash SHA-256.
  telegramLinkHash   String?   @unique
  telegramLinkExpiry DateTime?
  weeklyReport       Boolean   @default(true)
  ciFailureAlerts    Boolean   @default(true)
  stalledPrAlerts    Boolean   @default(true)
  // Giorno (0 = domenica) e ora locali del report settimanale, nel fuso `timezone` (IANA).
  weeklyDay          Int       @default(1)
  weeklyHour         Int       @default(8)
  timezone           String    @default("UTC")
  lastWeeklySentAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Alert già inviati: la chiave (es. URL della run CI fallita) evita di notificare due volte.
model NotificationEvent {
  id        String   @id @default(cuid())
  userId    String
  key       String
  kind      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// Chiave AI dell'utente per un provider del catalogo models.dev; senza, vale il default del server.
model AiCredential {
  id        String   @id @default(cuid())
  userId    String   @unique
  // Id del provider nel catalogo (es. "anthropic", "zai-coding-plan").
  provider  String
  model     String
  // Chiave API cifrata con AES-256-GCM: non torna mai al client.
  apiKeyEnc String
  // Ultimi 4 caratteri, per riconoscere la chiave nella UI.
  keyLast4  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Refresh token opachi: in DB solo l'hash SHA-256, mai il valore in chiaro.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  // Tutti i token nati dalla stessa login condividono la family: il riuso di un token
  // già ruotato revoca l'intera family (rilevamento furto).
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Repository {
  id            String     @id @default(cuid())
  userId        String
  githubId      Int
  name          String
  url           String
  defaultBranch String?
  isPrivate     Boolean    @default(false)
  syncStatus    SyncStatus @default(IDLE)
  // Inizio del sync in corso: permette di riprendere un lock rimasto appeso dopo un crash.
  syncStartedAt DateTime?
  lastSyncError String?
  lastSyncedAt  DateTime?
  createdAt     DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports       Report[]
  metrics       Metrics[]

  @@unique([userId, githubId])
  @@index([userId])
}

model Report {
  id           String     @id @default(cuid())
  repositoryId String
  // Markdown renderizzato dal server a partire da `data`: è ciò che viene mostrato ed esportato.
  content      String
  summary      String
  // Output strutturato del modello (validato con Zod). null per i report creati prima della Fase 4.
  data         Json?
  // Modello che ha servito la risposta (può differire da quello richiesto se interviene un fallback).
  model        String?
  // Provider del catalogo che ha generato il report (null per i report precedenti).
  provider     String?
  periodStart  DateTime?
  periodEnd    DateTime?
  inputTokens  Int?
  outputTokens Int?
  generatedAt  DateTime   @default(now())
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, generatedAt])
}

model Metrics {
  id           String     @id @default(cuid())
  repositoryId String
  date         DateTime   @db.Date
  openIssues   Int
  closedIssues Int
  openPRs      Int
  mergedPRs    Int
  // null quando nel giorno non ci sono run CI concluse con successo o fallimento.
  ciPassRate   Float?
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, date])
}
